# data.go.kr에는 Decoding 키를 사용하세요.
KMA_SERVICE_KEY=
AIRKOREA_SERVICE_KEY=

# Upstream origins only; collectors append endpoint paths.
KMA_BASE_URL=https://apis.data.go.kr
AIRKOREA_BASE_URL=https://apis.data.go.kr

WEATHER_UPSTREAM_CONNECT_TIMEOUT_S=3
WEATHER_UPSTREAM_READ_TIMEOUT_S=7
WEATHER_CACHE_TTL_KMA_CURRENT_S=600
WEATHER_CACHE_TTL_KMA_FORECAST_S=3600
WEATHER_CACHE_TTL_AIRKOREA_S=1800
WEATHER_CACHE_MAX_STALE_S=10800
WEATHER_UPSTREAM_RETRY_AFTER_S=60
# 저장소 루트 기준 경로입니다. 비워 두면 캐시를 파일로 저장하지 않습니다.
WEATHER_CACHE_FILE=weather/data/weather-cache.json
