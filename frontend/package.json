{
  "name": "digital-twin-bun",
  "version": "0.0.0",
  "scripts": {
    "dev": "vite",
    "dev:legacy": "vite --host 127.0.0.1 --port 5173",
    "dev:vworld": "vite --host 127.0.0.1 --port 5173 --open index-vworld.html",
    "build": "vite build",
    "build:vworld": "vite build --mode vworld --outDir dist-vworld",
    "preview": "vite preview",
    "test": "node scripts/run-tests.mjs",
    "model:fetch": "bun scripts/campus-model/fetch-sources.mjs",
    "model:build": "bun scripts/campus-model/build-campus-model.mjs && bun scripts/campus-model/pack.mjs",
    "model:pack": "bun scripts/campus-model/pack.mjs",
    "model:precompress": "bun scripts/campus-model/pack.mjs --precompress",
    "network:build": "bun scripts/campus-model/network/buildNetwork.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.16.2",
    "@react-three/postprocessing": "2.19.1",
    "lucide-react": "^1.7.0",
    "postprocessing": "6.39.5",
    "react": "^18.2.0",
    "react-dom": "^18.2.0",
    "suncalc": "^1.9.0",
    "three": "^0.186.1",
    "three-stdlib": "^2.36.1"
  },
  "overrides": {
    "postprocessing": "6.39.5"
  },
  "devDependencies": {
    "@gltf-transform/cli": "4.5.1",
    "@gltf-transform/core": "4.5.1",
    "@gltf-transform/extensions": "4.5.1",
    "@gltf-transform/functions": "4.5.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^18.2.66",
    "@types/react-dom": "^18.2.22",
    "@vitejs/plugin-react": "^4.2.1",
    "autoprefixer": "^10.4.19",
    "happy-dom": "^21.0.4",
    "jsdom": "^26.1.0",
    "meshoptimizer": "^1.3.0",
    "postcss": "^8.4.38",
    "sharp": "0.35.5",
    "tailwindcss": "^3.4.3",
    "three-mesh-bvh": "0.9.16",
    "vite": "^5.2.0",
    "vitest": "^3.2.7"
  }
}
